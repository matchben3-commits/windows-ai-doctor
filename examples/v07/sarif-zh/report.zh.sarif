{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/cos02/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Windows AI Doctor",
          "semanticVersion": "0.7.0",
          "informationUri": "https://github.com/matchben3-commits/windows-ai-doctor",
          "rules": [
            {
              "id": "claude.config.local",
              "name": "claude.config.local",
              "shortDescription": {
                "text": "在显式 --project 根下检查 Claude settings.local.json 的 UTF-8 语法与对象根。"
              },
              "fullDescription": {
                "text": "仅在提供 --project 时生成；不合并配置、不读账户、不判定本地覆盖是否生效。"
              },
              "help": {
                "text": "仅在提供 --project 时生成；不合并配置、不读账户、不判定本地覆盖是否生效。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "project_only",
                "evidence_fields": [
                  "layer",
                  "effective_loading",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "claude.config.project",
              "name": "claude.config.project",
              "shortDescription": {
                "text": "在显式 --project 根下检查 Claude 项目 settings.json 的 UTF-8 语法与对象根。"
              },
              "fullDescription": {
                "text": "仅在提供 --project 时生成；不向祖先遍历，不计算最终合并配置。"
              },
              "help": {
                "text": "仅在提供 --project 时生成；不向祖先遍历，不计算最终合并配置。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "project_only",
                "evidence_fields": [
                  "layer",
                  "effective_loading",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "claude.config.user",
              "name": "claude.config.user",
              "shortDescription": {
                "text": "检查用户层 Claude settings.json 的 UTF-8 语法与对象根。"
              },
              "fullDescription": {
                "text": "文件可缺省；语法通过不等于登录、API 或服务可用；不输出配置键值。"
              },
              "help": {
                "text": "文件可缺省；语法通过不等于登录、API 或服务可用；不输出配置键值。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "layer",
                  "location_source",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "claude.dependency",
              "name": "claude.dependency",
              "shortDescription": {
                "text": "观察已识别 Claude 入口所需的运行时线索（原生或 Node）。"
              },
              "fullDescription": {
                "text": "只覆盖入口所需运行时；不验证完整依赖树或全部可选功能。"
              },
              "help": {
                "text": "只覆盖入口所需运行时；不验证完整依赖树或全部可选功能。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "runtime",
                  "node_required",
                  "scope",
                  "node_found",
                  "node_path_check",
                  "documented_package_engine",
                  "reason",
                  "version",
                  "probe_reason"
                ]
              }
            },
            {
              "id": "claude.install",
              "name": "claude.install",
              "shortDescription": {
                "text": "根据入口布局观察 Claude 安装形式是否可识别。"
              },
              "fullDescription": {
                "text": "不是签名或发行方验证；未知形式不等于未安装。"
              },
              "help": {
                "text": "不是签名或发行方验证；未知形式不等于未安装。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "kind",
                  "publisher_verified"
                ]
              }
            },
            {
              "id": "claude.path",
              "name": "claude.path",
              "shortDescription": {
                "text": "在 PATH/PATHEXT 限定模型下观察 Claude 入口候选与安装组线索。"
              },
              "fullDescription": {
                "text": "不扫描磁盘；不预测别名/函数；受限扫描不能证明未安装或无重复。"
              },
              "help": {
                "text": "不扫描磁盘；不预测别名/函数；受限扫描不能证明未安装或无重复。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "entries",
                  "installation_groups",
                  "cmd_path_candidate",
                  "powershell_path_candidate",
                  "resolution_model",
                  "scan_limited"
                ]
              }
            },
            {
              "id": "claude.version",
              "name": "claude.version",
              "shortDescription": {
                "text": "对已识别 Claude 入口做有界 --version 观察。"
              },
              "fullDescription": {
                "text": "仅接受短且完整匹配的版本响应；通过只覆盖本次查询，不验证服务或任务。"
              },
              "help": {
                "text": "仅接受短且完整匹配的版本响应；通过只覆盖本次查询，不验证服务或任务。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "reason",
                  "returncode",
                  "version",
                  "captured_bytes",
                  "timeout_seconds"
                ]
              }
            },
            {
              "id": "codex.config.project",
              "name": "codex.config.project",
              "shortDescription": {
                "text": "在显式 --project 根下检查 Codex 项目 config.toml 的 UTF-8 语法与对象根。"
              },
              "fullDescription": {
                "text": "仅在提供 --project 时生成；不向祖先遍历，不计算最终合并配置。"
