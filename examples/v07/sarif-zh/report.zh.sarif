              "id": "wsl.launcher",
              "name": "wsl.launcher",
              "shortDescription": {
                "text": "观察系统目录下的 WSL 启动器是否存在（原生格式线索）。"
              },
              "fullDescription": {
                "text": "不检查组件健康；非 Windows 跳过；存在不等于发行版可用。"
              },
              "help": {
