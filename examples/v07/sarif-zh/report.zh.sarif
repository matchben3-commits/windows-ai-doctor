                "evidence_fields": [
                  "layer",
                  "effective_loading",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "codex.config.user",
              "name": "codex.config.user",
              "shortDescription": {
                "text": "检查用户层 Codex config.toml 的 UTF-8 语法与对象根。"
              },
              "fullDescription": {
                "text": "文件可缺省；语法通过不等于配置生效或服务可用；不输出配置键值。"
              },
              "help": {
                "text": "文件可缺省；语法通过不等于配置生效或服务可用；不输出配置键值。"
