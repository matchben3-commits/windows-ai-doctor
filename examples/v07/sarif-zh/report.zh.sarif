            {
              "id": "scope.unchecked",
              "name": "scope.unchecked",
              "shortDescription": {
                "text": "标明账户、认证、聊天、完整配置合并与真实 AI 任务等范围外项未检查。"
              },
              "fullDescription": {
                "text": "始终为 skipped 提示；不表示主机健康或其他检查已通过。"
              },
              "help": {
                "text": "始终为 skipped 提示；不表示主机健康或其他检查已通过。"
              },
