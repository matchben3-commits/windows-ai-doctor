                "availability": "always",
                "evidence_fields": []
              }
            },
            {
              "id": "system.platform",
              "name": "system.platform",
              "shortDescription": {
                "text": "记录当前解释器所见的操作系统类别与 Python 版本线索。"
              },
              "fullDescription": {
                "text": "不是硬件清单或补丁审计；Windows 目标标记只反映 os.name。"
              },
              "help": {
                "text": "不是硬件清单或补丁审计；Windows 目标标记只反映 os.name。"
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "system",
                "availability": "always",
                "evidence_fields": [
                  "os",
                  "python",
                  "windows_target"
                ]
              }
            },
            {
              "id": "wsl.internal",
              "name": "wsl.internal",
              "shortDescription": {
                "text": "标明 WSL 发行版内部环境始终未检查。"
              },
              "fullDescription": {
                "text": "始终 skipped；不启动发行版，也不把未安装 WSL 判为 AI 工具故障。"
              },
              "help": {
                "text": "始终 skipped；不启动发行版，也不把未安装 WSL 判为 AI 工具故障。"
