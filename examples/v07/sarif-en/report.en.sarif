                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "codex.dependency",
              "name": "codex.dependency",
              "shortDescription": {
                "text": "Observe runtime clues required by a recognized Codex launcher (native or Node)."
              },
              "fullDescription": {
                "text": "Covers launcher runtime only; the full dependency tree and optional features are not validated."
              },
              "help": {
                "text": "Covers launcher runtime only; the full dependency tree and optional features are not validated."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "codex",
                "availability": "always",
                "evidence_fields": [
                  "runtime",
                  "node_required",
                  "scope",
                  "node_found",
                  "node_path_check",
                  "documented_package_engine",
                  "reason",
                  "version",
                  "probe_reason"
                ]
              }
            },
            {
              "id": "codex.install",
              "name": "codex.install",
              "shortDescription": {
                "text": "Observe whether the Codex installation kind is recognizable from the launcher layout."
              },
              "fullDescription": {
                "text": "Not signature or publisher verification; an unknown kind does not prove absence of an installation."
              },
              "help": {
                "text": "Not signature or publisher verification; an unknown kind does not prove absence of an installation."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
