{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/cos02/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Windows AI Doctor",
          "semanticVersion": "0.7.0",
          "informationUri": "https://github.com/matchben3-commits/windows-ai-doctor",
          "rules": [
            {
              "id": "claude.config.local",
              "name": "claude.config.local",
              "shortDescription": {
                "text": "With an explicit --project root, check UTF-8 syntax and an object root for Claude settings.local.json."
              },
              "fullDescription": {
                "text": "Emitted only with --project; no merge evaluation, account checks, or proof that local overrides apply."
              },
              "help": {
                "text": "Emitted only with --project; no merge evaluation, account checks, or proof that local overrides apply."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "project_only",
                "evidence_fields": [
                  "layer",
                  "effective_loading",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "claude.config.project",
              "name": "claude.config.project",
              "shortDescription": {
                "text": "With an explicit --project root, check UTF-8 syntax and an object root for the Claude project settings.json."
              },
              "fullDescription": {
                "text": "Emitted only with --project; ancestors are not walked and effective merged configuration is not computed."
              },
              "help": {
                "text": "Emitted only with --project; ancestors are not walked and effective merged configuration is not computed."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "project_only",
                "evidence_fields": [
                  "layer",
                  "effective_loading",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "claude.config.user",
              "name": "claude.config.user",
              "shortDescription": {
                "text": "Check UTF-8 syntax and an object root for the user-layer Claude settings.json."
              },
              "fullDescription": {
                "text": "The file may be absent; valid syntax does not establish login, API or service availability; config values are not exported."
              },
              "help": {
                "text": "The file may be absent; valid syntax does not establish login, API or service availability; config values are not exported."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "layer",
                  "location_source",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "claude.dependency",
              "name": "claude.dependency",
              "shortDescription": {
                "text": "Observe runtime clues required by a recognized Claude launcher (native or Node)."
              },
              "fullDescription": {
                "text": "Covers launcher runtime only; the full dependency tree and optional features are not validated."
              },
              "help": {
                "text": "Covers launcher runtime only; the full dependency tree and optional features are not validated."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "runtime",
                  "node_required",
                  "scope",
                  "node_found",
                  "node_path_check",
                  "documented_package_engine",
                  "reason",
                  "version",
                  "probe_reason"
                ]
              }
            },
            {
              "id": "claude.install",
              "name": "claude.install",
              "shortDescription": {
                "text": "Observe whether the Claude installation kind is recognizable from the launcher layout."
              },
              "fullDescription": {
                "text": "Not signature or publisher verification; an unknown kind does not prove absence of an installation."
              },
              "help": {
                "text": "Not signature or publisher verification; an unknown kind does not prove absence of an installation."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "kind",
                  "publisher_verified"
                ]
              }
            },
            {
              "id": "claude.path",
              "name": "claude.path",
              "shortDescription": {
                "text": "Observe Claude PATH/PATHEXT candidates and installation-group clues under the limited resolution model."
              },
              "fullDescription": {
                "text": "No disk search; aliases/functions are outside prediction; a limited scan cannot prove absence or uniqueness."
              },
              "help": {
                "text": "No disk search; aliases/functions are outside prediction; a limited scan cannot prove absence or uniqueness."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "entries",
                  "installation_groups",
                  "cmd_path_candidate",
                  "powershell_path_candidate",
                  "resolution_model",
                  "scan_limited"
                ]
              }
            },
            {
              "id": "claude.version",
              "name": "claude.version",
              "shortDescription": {
                "text": "Perform a bounded --version observation against a recognized Claude launcher."
              },
              "fullDescription": {
                "text": "Only short complete version responses are accepted; a pass covers this query only, not service or task availability."
              },
              "help": {
                "text": "Only short complete version responses are accepted; a pass covers this query only, not service or task availability."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "claude",
                "availability": "always",
                "evidence_fields": [
                  "reason",
                  "returncode",
                  "version",
                  "captured_bytes",
                  "timeout_seconds"
                ]
              }
            },
            {
              "id": "codex.config.project",
              "name": "codex.config.project",
              "shortDescription": {
                "text": "With an explicit --project root, check UTF-8 syntax and an object root for the Codex project config.toml."
              },
              "fullDescription": {
                "text": "Emitted only with --project; ancestors are not walked and effective merged configuration is not computed."
              },
              "help": {
                "text": "Emitted only with --project; ancestors are not walked and effective merged configuration is not computed."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "codex",
                "availability": "project_only",
                "evidence_fields": [
                  "layer",
                  "effective_loading",
                  "path",
                  "format",
                  "syntax",
                  "line"
                ]
              }
            },
            {
              "id": "codex.config.user",
              "name": "codex.config.user",
              "shortDescription": {
                "text": "Check UTF-8 syntax and an object root for the user-layer Codex config.toml."
              },
              "fullDescription": {
                "text": "The file may be absent; valid syntax does not establish effective configuration or service availability; config values are not exported."
              },
              "help": {
                "text": "The file may be absent; valid syntax does not establish effective configuration or service availability; config values are not exported."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "codex",
                "availability": "always",
                "evidence_fields": [
                  "layer",
