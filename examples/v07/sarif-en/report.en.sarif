              }
            },
            {
              "id": "codex.path",
              "name": "codex.path",
              "shortDescription": {
                "text": "Observe Codex PATH/PATHEXT candidates and installation-group clues under the limited resolution model."
              },
              "fullDescription": {
                "text": "No disk search; aliases/functions are outside prediction; a limited scan cannot prove absence or uniqueness."
              },
              "help": {
                "text": "No disk search; aliases/functions are outside prediction; a limited scan cannot prove absence or uniqueness."
