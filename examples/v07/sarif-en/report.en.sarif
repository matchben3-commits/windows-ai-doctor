              "id": "codex.version",
              "name": "codex.version",
              "shortDescription": {
                "text": "Perform a bounded --version observation against a recognized Codex launcher."
              },
              "fullDescription": {
                "text": "Only short complete version responses are accepted; a pass covers this query only, not service or task availability."
              },
              "help": {
                "text": "Only short complete version responses are accepted; a pass covers this query only, not service or task availability."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "codex",
                "availability": "always",
                "evidence_fields": [
                  "reason",
                  "returncode",
                  "version",
                  "captured_bytes",
                  "timeout_seconds"
                ]
              }
            },
            {
              "id": "scope.unchecked",
              "name": "scope.unchecked",
              "shortDescription": {
                "text": "Record that accounts, authentication, chat history, full configuration merging and real AI tasks remain outside scope."
              },
              "fullDescription": {
                "text": "Always a skipped scope notice; it does not establish host health or that other checks passed."
              },
              "help": {
                "text": "Always a skipped scope notice; it does not establish host health or that other checks passed."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "scope",
                "availability": "always",
                "evidence_fields": []
              }
            },
            {
              "id": "system.platform",
              "name": "system.platform",
              "shortDescription": {
                "text": "Record the OS class and Python version clues visible to the current interpreter."
              },
              "fullDescription": {
                "text": "Not a hardware inventory or patch audit; the Windows-target flag reflects os.name only."
              },
              "help": {
                "text": "Not a hardware inventory or patch audit; the Windows-target flag reflects os.name only."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "system",
                "availability": "always",
                "evidence_fields": [
                  "os",
                  "python",
                  "windows_target"
                ]
              }
            },
            {
              "id": "wsl.internal",
              "name": "wsl.internal",
              "shortDescription": {
                "text": "Record that the WSL distribution interior is never inspected."
              },
              "fullDescription": {
                "text": "Always skipped; distributions are not started and absence of WSL is not treated as an AI tool failure."
              },
              "help": {
                "text": "Always skipped; distributions are not started and absence of WSL is not treated as an AI tool failure."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "wsl",
                "availability": "always",
                "evidence_fields": []
              }
            },
            {
              "id": "wsl.inventory",
              "name": "wsl.inventory",
              "shortDescription": {
                "text": "On Windows, observe the current-user Lxss registration subkey count clue."
              },
              "fullDescription": {
                "text": "Distribution names are not listed; non-Windows hosts skip; this is not component-health proof."
              },
              "help": {
                "text": "Distribution names are not listed; non-Windows hosts skip; this is not component-health proof."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "wsl",
                "availability": "always",
                "evidence_fields": [
                  "registered_count",
                  "reason"
                ]
              }
            },
            {
              "id": "wsl.launcher",
              "name": "wsl.launcher",
              "shortDescription": {
                "text": "Observe whether the system-directory WSL launcher is present (native-format clue)."
              },
              "fullDescription": {
                "text": "Component health is not checked; non-Windows hosts skip; presence does not establish a usable distribution."
              },
              "help": {
                "text": "Component health is not checked; non-Windows hosts skip; presence does not establish a usable distribution."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "wsl",
                "availability": "always",
                "evidence_fields": [
                  "present",
                  "component_health",
                  "reason"
                ]
              }
            },
            {
              "id": "wsl.running",
              "name": "wsl.running",
              "shortDescription": {
                "text": "When --wsl-list is explicit, observe a read-only running-distribution count."
              },
              "fullDescription": {
                "text": "Default is no execution; with explicit permission the list still runs even under --no-version; names are never exported."
              },
              "help": {
                "text": "Default is no execution; with explicit permission the list still runs even under --no-version; names are never exported."
              },
              "helpUri": "https://github.com/matchben3-commits/windows-ai-doctor/blob/main/docs/v07-contract.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "target": "wsl",
                "availability": "always",
                "evidence_fields": [
                  "reason",
                  "running_count",
                  "returncode"
                ]
              }
            }
          ]
        }
      },
