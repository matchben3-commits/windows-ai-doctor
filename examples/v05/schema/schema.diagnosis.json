{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matchben3-commits/windows-ai-doctor/schemas/diagnosis-1.0.schema.json",
  "title": "Windows AI Doctor diagnosis input, schema 1.0",
  "description": "Structural input rules, with unknown properties permitted and ignored. --validate is authoritative. Passing this schema does not establish health, completeness, trusted origin or machine identity. The parser additionally rejects oversized/deep inputs, excessive nodes, duplicate JSON keys or finding IDs, long numeric tokens/strings and non-finite numbers. JSON Schema integer accepts 1.0 and 1e0; the parser requires an integer JSON token for installation_groups on .path findings. Non-numeric version values are accepted but excluded from comparison, history and support projections.",
  "type": "object",
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_type": {
      "const": "diagnosis"
    },
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "enum": [
            "claude.config.local",
            "claude.config.project",
            "claude.config.user",
            "claude.dependency",
            "claude.install",
            "claude.path",
            "claude.version",
            "codex.config.project",
            "codex.config.user",
            "codex.dependency",
            "codex.install",
            "codex.path",
            "codex.version",
            "scope.unchecked",
            "system.platform",
            "wsl.internal",
            "wsl.inventory",
            "wsl.launcher",
            "wsl.running"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "error",
            "unknown",
            "skipped"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "if": {
        "properties": {
          "id": {
            "enum": [
              "claude.path",
              "codex.path"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "$ref": "#/$defs/path_evidence"
          }
        }
      }
    },
    "path_evidence": {
      "type": "object",
      "properties": {
        "installation_groups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "scan_limited": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "x-parser-limits": {
    "max_bytes": 2097152,
    "max_depth": 16,
    "max_nodes": 20000,
    "unique_finding_ids": true,
    "max_string_characters": 32768,
    "max_integer_token_characters": 12,
    "max_float_token_characters": 32,
    "finite_numbers_only": true,
    "integer_tokens_for_path_groups": true
  },
  "x-version-projection": {
    "ids": [
      "claude.dependency",
      "claude.version",
      "codex.dependency",
      "codex.version"
    ],
    "field": "version",
    "pattern": "[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}",
    "match": "full string",
    "description": "Annotation, not an input constraint: only matching strings are projected; all other values are ignored."
  }
}
